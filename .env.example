# ========================================================
# SaaS Subscription Platform - Environment Configuration
# ========================================================

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database URL (Connection String)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_subscription_db?schema=public"

# Stripe API Keys (Get these from your Stripe Dashboard: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_mock_stripe_key_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_mock_stripe_key_placeholder"

# Stripe Webhook Secret (from Stripe CLI: stripe listen --print-secret)
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_webhook_secret_placeholder"

# Stripe Price IDs (Generated when products are created)
NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTHLY="price_starter_monthly_test"
NEXT_PUBLIC_STRIPE_PRICE_STARTER_YEARLY="price_starter_yearly_test"
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY="price_pro_monthly_test"
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY="price_pro_yearly_test"
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_MONTHLY="price_enterprise_monthly_test"
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_YEARLY="price_enterprise_yearly_test"

# Admin Secret / Session Settings
ADMIN_SECRET="admin-super-secure-key"
